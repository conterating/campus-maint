# SQLite database file (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Optional: Claude triage. Without a key, FixIt GT uses its keyword classifier.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: signs the AI verdict between "analyze" and "submit". Random per process if unset.
TRIAGE_SIGNING_SECRET=

# Optional: Google Maps for the campus map. Without a key, the map uses OpenStreetMap.
# Needs the Maps JavaScript API enabled on a Google Cloud project with billing.
# Restrict the key to your site's HTTP referrers: it is sent to the browser.
GOOGLE_MAPS_API_KEY=
# Map ID for advanced markers. Leave blank to use Google's DEMO_MAP_ID (fine for development).
GOOGLE_MAPS_MAP_ID=

# Optional: base URL encoded into printable QR codes (defaults to the request's host).
PUBLIC_BASE_URL=
