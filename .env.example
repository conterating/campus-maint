# SQLite database file (relative to prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Optional: Claude triage. Without a key, Ramblin’ Repairs uses its keyword classifier.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: signs the AI verdict between "analyze" and "submit". Random per process if unset.
TRIAGE_SIGNING_SECRET=

# Optional: base URL encoded into printable QR codes (defaults to the request's host).
PUBLIC_BASE_URL=

# Optional: Google Maps (Maps JavaScript API) browser key for the campus map.
# Restrict it to your site's domain in Google Cloud. Without it the map uses
# OpenStreetMap tiles.
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Accounts (Better Auth)
# ---------------------------------------------------------------------------

# Required. Signs sessions and encrypts two-factor secrets. Generate one with:
#   openssl rand -base64 32
# Changing it signs everyone out and invalidates enrolled authenticators
# (run `npm run db:reset` to re-enroll the demo admin).
BETTER_AUTH_SECRET=

# The URL people open the app at. Used for email links and the trusted origin
# for Better Auth's CSRF/origin checks. Cookies are Secure when this is https.
BETTER_AUTH_URL=http://localhost:3000

# Optional. Sends verification, password-reset and invite emails through Resend.
# Without it, emails are printed to the server console and appended to
# .mail/outbox.jsonl so you can click the links yourself.
RESEND_API_KEY=
# Sender for those emails, e.g. "Ramblin' Repairs <repairs@yourdomain.edu>".
EMAIL_FROM=

# "true" keeps the Demo page (view as, fast-forward clock, reset data) for
# signed-in administrators. Set to false for anything real.
DEMO_MODE=true

# Password for every seeded demo account (12+ characters). Falls back to
# "buzz-fixes-everything" when empty.
SEED_DEMO_PASSWORD=
