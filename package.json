{
  "name": "ramblin-repairs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:reset": "prisma db push && prisma db seed",
    "setup": "tsx scripts/ensure-secret.ts && prisma generate && npm run db:reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run lint && npm run test && npm run test:e2e",
    "demo:totp": "tsx scripts/demo-totp.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@prisma/client": "^6.19.3",
    "@vis.gl/react-google-maps": "^1.10.2",
    "better-auth": "^1.7.25",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^1.0.1",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "^5.0.0",
    "resend": "^6.38.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/google.maps": "^3.66.9",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
