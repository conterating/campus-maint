// Ramblin’ Repairs data model.
// SQLite has no native enums, so string columns hold the values defined in
// src/lib/domain.ts; the application validates them before writing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Building {
  id      String  @id
  code    String  @unique
  name    String
  // RESIDENCE | LIBRARY | DINING | STUDENT_CENTER | RECREATION | ACADEMIC
  kind    String
  lat     Float
  lng     Float
  floors  Int
  address String?
  // Housing area for residence halls: EAST | WEST | NORTH_AVE | GRAD
  area    String?

  spaces    Space[]
  assets    Asset[]
  tickets   Ticket[]
  residents User[]   @relation("Residence")
  advisories Advisory[]
}

model Space {
  id         String   @id
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  floor      Int?
  label      String
  // DORM_ROOM | DORM_SHARED | PUBLIC
  scope      String
  // Free-form kind for display: room, hallway, bathroom, lounge, laundry,
  // classroom, study, dining, gym, lobby, ...
  kind       String

  assets    Asset[]
  tickets   Ticket[]
  residents User[]   @relation("Room")

  @@index([buildingId])
}

model Asset {
  id         String   @id
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  spaceId    String?
  space      Space?   @relation(fields: [spaceId], references: [id])
  name       String
  // PROJECTOR | WASHER | DRYER | ELEVATOR | TREADMILL | ...
  type       String
  tag        String   @unique

  tickets Ticket[]

  @@index([buildingId])
}

model User {
  id                  String    @id
  advisoriesCreated   Advisory[] @relation("AdvisoryCreator")
  name                String
  email               String    @unique
  // STUDENT | CONTRACTOR | STAFF | ADMIN (see src/lib/domain.ts)
  role                String    @default("STUDENT")
  // Department key for staff (see src/lib/domain.ts DEPARTMENTS)
  department          String?
  isSupervisor        Boolean   @default(false)
  residenceBuildingId String?
  residenceBuilding   Building? @relation("Residence", fields: [residenceBuildingId], references: [id])
  roomId              String?
  room                Space?    @relation("Room", fields: [roomId], references: [id])
  avatarHue           Int       @default(210)

  // Sign-in identity. Lowercase; required by validation for every account, but
  // nullable in the database so rows created before accounts existed stay valid.
  username           String? @unique
  displayUsername    String?
  // 9 digits starting with "90". Required by validation for students and
  // staff/admins; null for contractors, who have no GT account.
  gtId               String? @unique
  firstName          String  @default("")
  lastName           String  @default("")
  preferredName      String?
  // WOMAN | MAN | NONBINARY | SELF_DESCRIBE | PREFER_NOT_TO_SAY
  gender             String?
  genderSelfDescribe String?
  // FIRST | SECOND | THIRD | FOURTH | FIFTH_PLUS | GRADUATE
  studentYear        String?
  phone              String?

  residenceVerified     Boolean   @default(false)
  residenceVerifiedAt   DateTime?
  residenceVerifiedById String?
  residenceVerifiedBy   User?     @relation("ResidenceVerifier", fields: [residenceVerifiedById], references: [id])
  residencesVerified    User[]    @relation("ResidenceVerifier")

  termsAcceptedAt DateTime?
  disabledAt      DateTime?
  lastLoginAt     DateTime?

  // Better Auth
  emailVerified    Boolean  @default(false)
  image            String?
  twoFactorEnabled Boolean? @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  reported      Ticket[]       @relation("Reporter")
  owned         Ticket[]       @relation("Owner")
  assigned      Ticket[]       @relation("Assignee")
  follows       Follow[]
  meToos        MeToo[]
  events        TicketEvent[]
  notifications Notification[]

  sessions          Session[]
  accounts          Account[]
  twoFactors        TwoFactor[]
  contractorProfile ContractorProfile?
  staffProfile      StaffProfile?
  workLogs          WorkLog[]
  scheduledJobs     ScheduledJob[]
  breaks            ContractorBreak[]
  auditEntries      AuditLog[]
}

model Ticket {
  id          String  @id @default(cuid())
  number      Int     @unique
  summary     String
  description String
  photoUrl    String?

  // Final (possibly corrected or overridden) classification
  category   String
  severity   String
  department String

  // What the triage engine said originally
  aiCategory   String
  aiSeverity   String
  aiDepartment String
  aiSummary    String
  aiSource     String // "claude" | "keywords"
  aiRationale  String?
  safetyFlag   Boolean @default(false)

  status String @default("SUBMITTED")

  // Location
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  spaceId    String?
  space      Space?   @relation(fields: [spaceId], references: [id])
  assetId    String?
  asset      Asset?   @relation(fields: [assetId], references: [id])
  floor      Int?
  roomText   String?
  lat        Float
  lng        Float

  // Visibility scope, derived from the location at creation time:
  // ROOM (residents of spaceId + staff), DORM (residents of buildingId + staff), PUBLIC.
  scope String

  // Ownership
  ownerType   String // STUDENT | DEPARTMENT
  ownerUserId String?
  ownerUser   User?   @relation("Owner", fields: [ownerUserId], references: [id])
  reporterId  String
  reporter    User    @relation("Reporter", fields: [reporterId], references: [id])
  assigneeId  String?
  assignee    User?   @relation("Assignee", fields: [assigneeId], references: [id])

  meTooCount Int @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  responseDueAt   DateTime
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  escalatedAt     DateTime?

  events        TicketEvent[]
  followers     Follow[]
  meToos        MeToo[]
  notifications Notification[]

  workLogs WorkLog[]
  scheduledJobs ScheduledJob[]

  // Skills the job needs (comma-separated Skill keys) and a rough duration for scheduling
  requiredSkills   String @default("")
  estimatedMinutes Int    @default(60)

  @@index([scope, buildingId])
  @@index([department, status])
  @@index([status])
  @@index([reporterId])
  @@index([ownerUserId])
  @@index([assigneeId])
}

model TicketEvent {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // STATUS | NOTE | COMMENT | REASSIGN | OVERRIDE | ESCALATED | METOO | PRIORITY | FOLLOW
  type       String
  fromStatus String?
  toStatus   String?
  message    String
  // COMMENT only: JSON array of /uploads/... photo URLs (SQLite has no list
  // columns). Read it through parseEventPhotos() in src/lib/domain.ts.
  photos     String?
  // Internal staff notes are never sent to students.
  internal   Boolean  @default(false)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  createdAt  DateTime @default(now())

  @@index([ticketId, createdAt])
}

model Follow {
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@id([ticketId, userId])
}

model MeToo {
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@id([ticketId, userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  ticketId  String?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message   String
  // Optional link target for notifications that aren't about a ticket (e.g. /advisories).
  href      String?
  // info | success | warning | danger
  tone      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

// Key/value store for demo settings (e.g. the fast-forward clock offset).
model Setting {
  key   String @id
  value String
}

// ---------------------------------------------------------------------------
// Accounts and roles
// ---------------------------------------------------------------------------

// The worker who does the job. 1:1 with a CONTRACTOR user.
model ContractorProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Badge or vendor number
  contractorId          String    @unique
  companyName           String
  companyPhone          String?
  // Comma-separated Category keys, e.g. "PLUMBING,HVAC"
  trades                String
  // Comma-separated Department keys they work for
  departments           String
  licenseNumber         String?
  licenseExpiresAt      DateTime?
  insuranceExpiresAt    DateTime?
  // PENDING | CLEARED | EXPIRED
  backgroundCheckStatus String    @default("PENDING")
  backgroundCheckedAt   DateTime?
  // Allowed to work inside residence hall rooms
  residenceHallAccess   Boolean   @default(false)
  // AVAILABLE | ON_JOB | ON_BREAK | OFF_DUTY
  availability          String    @default("OFF_DUTY")
  // Comma-separated Skill keys (see SKILLS in domain.ts). Empty = fall back to trades.
  skills                String    @default("")
  // Shift, minutes after local midnight (420 = 7:00 AM), on the days in workDays (0 = Sunday)
  shiftStartMinute      Int       @default(420)
  shiftEndMinute        Int       @default(960)
  workDays              String    @default("1,2,3,4,5")
  // May take Emergency jobs outside their shift
  onCall                Boolean   @default(false)
  maxActiveJobs         Int       @default(5)
  // Visible to ADMIN only
  hourlyRate            Float?
  contractStartsAt      DateTime?
  contractEndsAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

// Time on a job. One or more per ticket per contractor.
model WorkLog {
  id                 String    @id @default(cuid())
  ticketId           String
  ticket             Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  contractorId       String
  contractor         User      @relation(fields: [contractorId], references: [id])
  startedAt          DateTime
  endedAt            DateTime?
  minutes            Int?
  // For ROOM-scope tickets
  roomEnteredAt      DateTime?
  roomExitedAt       DateTime?
  materials          String?
  materialsCost      Float?
  laborCost          Float?
  notes              String?
  completionPhotoUrl String?
  createdAt          DateTime  @default(now())

  @@index([ticketId])
  @@index([contractorId, startedAt])
}

// 1:1 with a STAFF or ADMIN user. ADMIN implies every permission.
model StaffProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId           String   @unique
  title                String
  officePhone          String?
  officeLocation       String?
  canManageUsers       Boolean  @default(false)
  canManageContractors Boolean  @default(false)
  canVerifyResidence   Boolean  @default(false)
  canViewAnalytics     Boolean  @default(false)
  canAssignWork        Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// Every account/permission change and every impersonation.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  // See AUDIT_ACTIONS in src/lib/domain.ts
  action     String
  targetType String
  targetId   String
  // JSON snapshots
  before     String?
  after      String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId, createdAt])
}

// Sign-in attempts by username, for the 5-failures-in-15-minutes lockout.
model LoginAttempt {
  id        String   @id @default(cuid())
  username  String
  success   Boolean
  // Why a correct-looking attempt was refused (never shown to the user).
  reason    String?
  // Client address the attempt came from, so a lockout is per username + address.
  ip        String?
  createdAt DateTime @default(now())

  @@index([username, createdAt])
}

// ---------------------------------------------------------------------------
// Better Auth (https://www.better-auth.com/docs/concepts/database)
// ---------------------------------------------------------------------------

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

// An "avoid this area" notice shown on the home pages and /advisories.
model Advisory {
  id          String    @id @default(cuid())
  title       String
  message     String
  // EMERGENCY | WARNING | INFO
  severity    String
  buildingId  String?
  building    Building? @relation(fields: [buildingId], references: [id])
  // Free-text place label, e.g. "Ferst Drive between Atlantic and Hemphill"
  area        String?
  lat         Float?
  lng         Float?
  startsAt    DateTime
  endsAt      DateTime?
  clearedAt   DateTime?
  // Set once, atomically, when the broadcast goes out (idempotent fan-out)
  notifiedAt  DateTime?
  createdById String
  createdBy   User      @relation("AdvisoryCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clearedAt, endsAt])
}

// A slot on a contractor's calendar for a ticket, written by the scheduler.
model ScheduledJob {
  id            String   @id @default(cuid())
  ticketId      String
  ticket        Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  contractorId  String
  contractor    User     @relation(fields: [contractorId], references: [id])
  // PRIMARY | HELPER
  role          String   @default("PRIMARY")
  startsAt      DateTime
  endsAt        DateTime
  travelMinutes Int      @default(0)
  // SCHEDULED | IN_PROGRESS | DONE | CANCELLED
  status        String   @default("SCHEDULED")
  score         Float    @default(0)
  // Human-readable explanation of the score
  reasons       String   @default("")
  createdAt     DateTime @default(now())

  @@index([contractorId, startsAt])
  @@index([ticketId])
}

// Time a contractor has blocked off (lunch, meetings). The scheduler works around it.
model ContractorBreak {
  id           String   @id @default(cuid())
  contractorId String
  contractor   User     @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  startsAt     DateTime
  endsAt       DateTime
  reason       String?
  createdAt    DateTime @default(now())

  @@index([contractorId, startsAt])
}

// One row per rate-limited event (sign-up, reset request, 2FA failure, ...).
// Counted in a sliding window by src/lib/rate-limit.ts.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
